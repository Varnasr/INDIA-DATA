# Ignore stray CSV files, but never the data: the Bihar build reads its
# sources from data/, and an ignored source file fails CI on a clean checkout.
*.csv
!data/**/*.csv

# Ignore common OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore any temporary HTML files
temp_*.html

# Added by git standards propagation
# Environment files
.env
.env.*
!.env.example
node_modules/
*.log
build/
dist/
coverage/
*.swp
